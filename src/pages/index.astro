---
// src/pages/index.astro
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro'
import Carousel1 from "../assets/carousel/1.jpg";
import Carousel2 from "../assets/carousel/2.jpg";
import Carousel3 from "../assets/carousel/3.jpg";
import Carousel4 from "../assets/carousel/4.jpg";
import Carousel5 from "../assets/carousel/5.jpg";
import Carousel6 from "../assets/carousel/6.jpg";
import Carousel7 from "../assets/carousel/7.jpg";
import Carousel8 from "../assets/carousel/8.jpg";
import Carousel9 from "../assets/carousel/9.jpg";
import Carousel10 from "../assets/carousel/10.jpg";
import FranMagni from "../assets/profesionals/franmagni.jpg";
import GiseMunno from "../assets/profesionals/gisemunno.jpg";
import Form from '../components/Form.jsx';
import AlphazetLight from "../fonts/Alphazet-Light.ttf";
---

<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Aurora Ambiental — Consultora en Ambiente y Cambio Climático</title>
    <meta name="description" content="Consultora especializada en ambiente y cambio climático. Asesoramiento técnico-ambiental para organizaciones." />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet" />
    <style>
      @font-face {
        font-family: 'Alphazet';
        src: url('../fonts/Alphazet-Light.ttf') format('truetype');
        font-weight: 300;
        font-style: normal;
        font-display: swap;
      }

      /* ── VARIABLES GLOBALES ── */
      :root {
        --green-deep:   #1a3a2a;
        --green-mid:    #2d6a4f;
        --green-light:  #52b788;
        --green-pale:   #d8f3dc;
        --ink:          #111110;
        --muted:        #5a6b60;
        --border:       #d4e4d8;
        --bg:           #f4f8f5;
        --white:        #ffffff;
        --header-total: 190px;
        /* Padding horizontal global — se reduce en breakpoints */
        --px: clamp(16px, 5vw, 72px);
      }

      /* ── TEMA OSCURO ── */
      .dark-theme {
        --ink:          #e8e8e6;
        --muted:        #a8b8a8;
        --border:       #3a4a3a;
        --bg:           #0f1a12;
        --white:        #1a2a1f;
      }

      .dark-theme body,
      .dark-theme {
        background: var(--bg);
        color: var(--ink);
      }

      .dark-theme .header-main {
        background: rgba(15, 26, 18, 0.97);
        border-bottom-color: rgba(82, 183, 136, 0.2);
      }

      .dark-theme .logo-name,
      .dark-theme .hero-title,
      .dark-theme .section-title,
      .dark-theme .about-quote,
      .dark-theme .service-name,
      .dark-theme .team-name,
      .dark-theme .eje-content h3 {
        color: var(--ink);
      }

      .dark-theme .hero-sub,
      .dark-theme .about-text,
      .dark-theme .service-desc,
      .dark-theme .eje-content p,
      .dark-theme .pillar p,
      .dark-theme .tag,
      .dark-theme .contact-intro > p,
      .dark-theme .contact-detail {
        color: var(--muted);
      }

      .dark-theme nav a {
        color: #a0b0a0;
      }
      .dark-theme nav a:hover {
        color: var(--ink);
      }

      .dark-theme .service-card {
        background: var(--white);
      }
      .dark-theme .eje-card {
        background: var(--white);
      }
      .dark-theme .eje-card:hover {
        background: #152318;
      }
      .dark-theme .team-card {
        background: var(--white);
      }
      .dark-theme .pillar {
        border-color: var(--border);
      }
      .dark-theme .pillar:hover {
        background: #152318;
        border-color: var(--green-light);
      }
      .dark-theme .tag {
        border-color: var(--border);
      }
      .dark-theme .tag:hover {
        background: #152318;
        border-color: var(--green-mid);
      }
      .dark-theme .team-card:hover {
        border-color: var(--green-light);
        box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
      }
      .dark-theme .team-toggle-btn {
        color: var(--green-light);
      }
      .dark-theme .team-toggle-btn:hover {
        color: #ffffff;
      }
      .dark-theme .team-description p {
        border-top-color: rgba(82, 183, 136, 0.2);
      }
      .dark-theme .team-description p {
        color: #c8d4c8;
      }
      .dark-theme .section-link {
        color: var(--muted);
        border-color: var(--border);
      }
      .dark-theme .section-link:hover {
        color: var(--green-light);
        border-color: var(--green-light);
      }
      .dark-theme .contact-detail strong {
        color: var(--ink);
      }
      .dark-theme .contact-detail-icon {
        background: #1a2a1f;
      }
      .dark-theme #servicios,
      .dark-theme #contacto {
        background: var(--bg);
      }
      .dark-theme .about-content {
        background: #0a150b;
      }
      .dark-theme .about-image::after {
        background: linear-gradient(to right, transparent 60%, rgba(15, 26, 18, 0.6) 100%);
      }
      .dark-theme .btn-ghost {
        border-color: rgba(82, 183, 136, 0.35);
        color: var(--green-light);
      }
      .dark-theme .btn-ghost:hover {
        background: #1a2a1f;
        border-color: var(--green-light);
      }
      .dark-theme #equipo {
        background: #0a150b;
      }
      .dark-theme #ejes {
        background: #0a150b;
      }
      .dark-theme .ejes-grid {
        background: rgba(82, 183, 136, 0.1);
      }
      .dark-theme .nav-cta {
        background: var(--green-mid);
        border-color: var(--green-mid);
      }
      .dark-theme .nav-cta:hover {
        background: var(--green-deep);
        border-color: var(--green-deep);
      }
      .dark-theme .mobile-menu {
        border-color: rgba(82, 183, 136, 0.3);
      }
      .dark-theme .mobile-menu span {
        background: var(--ink);
      }
      .dark-theme .mobile-menu:hover {
        background: #1a2a1f;
      }
      .dark-theme nav {
        background: #0f1a12;
        border-bottom-color: rgba(82, 183, 136, 0.2);
      }
      .dark-theme nav a {
        border-bottom-color: rgba(82, 183, 136, 0.1);
      }
      .dark-theme nav a:hover {
        background: #1a2a1f;
        color: var(--green-light);
      }
      .dark-theme nav.is-open::after {
        background: #1a2a1f;
        color: var(--green-light);
      }
      .dark-theme .theme-toggle {
        border-color: rgba(82, 183, 136, 0.3);
      }
      .dark-theme .theme-toggle:hover {
        background: #1a2a1f;
        border-color: var(--green-light);
      }
      .dark-theme .theme-toggle svg {
        color: var(--ink);
      }

      /* ── SERVICIOS HOVER EN TEMA OSCURO ── */
      .dark-theme #servicios {
        background: #0a150b;
      }
      .dark-theme .service-card {
        background: #0f1a12;
      }
      .dark-theme .service-name,
      .dark-theme .service-desc {
        color: #d8e0d8;
      }
      .dark-theme .service-number {
        color: #74c69d;
      }
      .dark-theme .service-divider {
        background: rgba(82, 183, 136, 0.2);
      }
      .dark-theme .service-card:hover {
        background: #1a3a2a;
      }
      .dark-theme .service-card:hover .service-number,
      .dark-theme .service-card:hover .service-name,
      .dark-theme .service-card:hover .service-desc {
        color: #ffffff;
      }
      .dark-theme .service-card:hover .service-divider {
        background: rgba(255, 255, 255, 0.18);
      }
      .dark-theme .services-grid {
        background: rgba(82, 183, 136, 0.1);
      }

      /* ── EJES HOVER EN TEMA OSCURO ── */
      .dark-theme #ejes {
        background: #0a150b;
      }
      .dark-theme .eje-card {
        background: #0f1a12;
      }
      .dark-theme .eje-content h3,
      .dark-theme .eje-content p {
        color: #d8e0d8;
      }
      .dark-theme .eje-card:hover {
        background: #152318;
      }
      .dark-theme .eje-card:hover .eje-content h3,
      .dark-theme .eje-card:hover .eje-content p {
        color: #ffffff;
      }
      .dark-theme .ejes-grid {
        background: rgba(82, 183, 136, 0.1);
      }

      /* ── TEXTOS MAS CLAROS EN TEMA OSCURO ── */
      .dark-theme .hero-sub,
      .dark-theme .about-text,
      .dark-theme .service-desc,
      .dark-theme .eje-content p,
      .dark-theme .pillar p,
      .dark-theme .tag,
      .dark-theme .contact-intro > p,
      .dark-theme .contact-detail {
        color: #c8d4c8;
      }
      .dark-theme .section-label {
        color: #74c69d;
      }

      /* ══════════════════════════════════════
         RESET ANTI–SCROLL-HORIZONTAL
      ══════════════════════════════════════ */
      *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }
      html { scroll-behavior: smooth; overflow-x: hidden; }
      body {
        background: var(--bg);
        color: var(--ink);
        font-family: 'DM Sans', sans-serif;
        font-weight: 300;
        line-height: 1.6;
        overflow-x: hidden;
        max-width: 100%;
      }
      /* Ningún hijo puede ser más ancho que el viewport */
      main { padding-top: var(--header-total); overflow-x: hidden; width: 100%; }
      img  { max-width: 100%; display: block; height: auto; }
      section, div { min-width: 0; }

      /* ── REVEAL ── */
      .reveal {
        opacity: 0;
        transform: translateY(24px);
        transition: opacity 0.9s cubic-bezier(.16,1,.3,1), transform 0.9s cubic-bezier(.16,1,.3,1);
      }
      .reveal.visible { opacity: 1; transform: translateY(0); }
      .reveal-delay-1 { transition-delay: 0.10s; }
      .reveal-delay-2 { transition-delay: 0.22s; }
      .reveal-delay-3 { transition-delay: 0.34s; }
      .reveal-delay-4 { transition-delay: 0.46s; }

      /* ── TIPOGRAFÍA COMPARTIDA ── */
      .section-label {
        font-size: 0.7rem;
        letter-spacing: 0.2em;
        text-transform: uppercase;
        color: var(--green-light);
        margin-bottom: 14px;
        display: block;
      }
      .section-title {
        font-family: 'Alphazet', serif;
        font-size: clamp(1.75rem, 3.5vw, 3rem);
        font-weight: 300;
        line-height: 1.12;
        color: var(--green-deep);
      }
      .section-title em { font-style: italic; color: var(--green-light); }

      /* ── BOTONES ── */
      .btn-primary {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        background: var(--green-mid);
        color: var(--white);
        padding: 13px 26px;
        font-size: 0.78rem;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        text-decoration: none;
        border-radius: 2px;
        transition: background 0.3s, gap 0.3s;
        white-space: nowrap;
        width: fit-content;
      }
      .btn-primary:hover { background: var(--green-deep); gap: 14px; }
      .btn-primary svg { width: 13px; height: 13px; flex-shrink: 0; }

      .btn-ghost {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        border: 1px solid rgba(45,106,79,0.35);
        color: var(--green-mid);
        padding: 12px 22px;
        font-size: 0.78rem;
        letter-spacing: 0.08em;
        text-decoration: none;
        border-radius: 2px;
        transition: border-color 0.3s, background 0.3s, color 0.3s;
        white-space: nowrap;
        width: fit-content;
      }
      .btn-ghost:hover { border-color: var(--green-mid); background: var(--green-pale); }

      /* Fila de botones — se apila en mobile */
      .hero-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        align-items: center;
      }

      /* ══════════════════════════════════════
         CAROUSEL — #galeria
      ══════════════════════════════════════ */
      #galeria {
        background: var(--green-deep);
        padding: 64px 0 60px;
        position: relative;
        width: 100%;
      }

      .galeria-header {
        padding: 0 var(--px);
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        margin-bottom: 40px;
        gap: 20px;
        flex-wrap: wrap;
      }
      .galeria-header .section-label { color: rgba(216,243,220,0.6); }
      .galeria-header .section-title { color: #ffffff; font-size: clamp(1.5rem, 3vw, 2.6rem); }
      .galeria-header .section-title em { color: var(--green-light); }

      .carousel-wrapper {
        position: relative;
        width: 100%;
        max-width: 100%;
        padding: 0 80px;
      }

      .carousel-viewport {
        overflow: hidden;
        width: 100%;
      }

      .carousel-track {
        display: flex;
        transition: transform 0.5s cubic-bezier(0.4, 0, 0.2, 1);
      }

      .carousel-slide {
        min-width: 100%;
        width: 100%;
        height: 0;
        padding-bottom: 56.25%;
        position: relative;
        overflow: hidden;
        background: #0f1a12;
      }
      .carousel-slide img {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        object-fit: contain;
        object-position: center;
        display: block;
      }
      .slide-label {
        position: absolute;
        bottom: 0;
        left: 0;
        right: 0;
        padding: 60px 24px 24px;
        background: linear-gradient(to top, rgba(0,0,0,0.7) 0%, transparent 100%);
        color: #ffffff;
        font-family: 'Alphazet', serif;
        font-size: clamp(1.2rem, 2.5vw, 1.8rem);
        font-weight: 600;
        text-align: center;
        z-index: 5;
        opacity: 0;
        transform: translateY(20px);
        transition: opacity 0.5s ease, transform 0.5s ease;
      }
      .carousel-slide.active .slide-label {
        opacity: 1;
        transform: translateY(0);
      }

      .carousel-btn {
        position: absolute;
        top: 50%;
        transform: translateY(-50%);
        width: 48px;
        height: 48px;
        border-radius: 50%;
        border: 1.5px solid rgba(255,255,255,0.3);
        background: rgba(0,0,0,0.5);
        backdrop-filter: blur(8px);
        color: white;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.3s;
        z-index: 10;
      }
      .carousel-btn:hover {
        background: var(--green-mid);
        border-color: var(--green-light);
        transform: translateY(-50%) scale(1.1);
      }
      .carousel-btn:active {
        transform: translateY(-50%) scale(0.95);
      }
      .carousel-btn svg {
        width: 20px;
        height: 20px;
        stroke-width: 2;
      }
      #prev-btn { left: 20px; }
      #next-btn { right: 20px; }

      .carousel-dots {
        display: flex;
        justify-content: center;
        gap: 10px;
        margin-top: 24px;
      }
      .carousel-dot {
        width: 10px;
        height: 10px;
        border-radius: 50%;
        background: rgba(255,255,255,0.3);
        border: none;
        cursor: pointer;
        transition: all 0.3s;
        padding: 0;
      }
      .carousel-dot:hover {
        background: rgba(255,255,255,0.6);
      }
      .carousel-dot.active {
        background: var(--green-light);
        transform: scale(1.2);
      }

      /* ── TEMA OSCURO CAROUSEL ── */
      .dark-theme #galeria {
        background: #0a150b;
      }
      .dark-theme .galeria-header .section-label {
        color: #74c69d;
      }
      .dark-theme .galeria-header .section-title {
        color: #ffffff;
      }
      .dark-theme .carousel-dot {
        background: rgba(255,255,255,0.25);
      }
      .dark-theme .carousel-dot:hover {
        background: rgba(255,255,255,0.5);
      }
      .dark-theme .carousel-dot.active {
        background: #52b788;
      }

      /* ── STATS BAR TEMA OSCURO ── */
      .dark-theme .stats-bar {
        background: #0a150b;
      }
      .dark-theme .stat-number {
        color: #ffffff;
      }
      .dark-theme .stat-label {
        color: rgba(255,255,255,0.5);
      }

      /* ══════════════════════════════════════
         HERO — #inicio
      ══════════════════════════════════════ */
      #inicio {
        min-height: calc(100vh - var(--header-total));
        display: grid;
        grid-template-columns: 1fr 1fr;
        width: 100%;
      }
      .hero-text {
        display: flex;
        flex-direction: column;
        justify-content: center;
        padding: 72px var(--px);
        min-width: 0;
      }
      .hero-eyebrow { display: flex; align-items: center; gap: 10px; margin-bottom: 24px; }
      .hero-eyebrow-line { width: 28px; height: 1px; background: var(--green-light); flex-shrink: 0; }
      .hero-eyebrow span { font-size: 0.7rem; letter-spacing: 0.2em; text-transform: uppercase; color: var(--green-light); }

      .hero-title {
        font-family: 'Alphazet', serif;
        font-size: clamp(2.2rem, 4vw, 5rem);
        font-weight: 300;
        line-height: 1.08;
        color: var(--green-deep);
        margin-bottom: 24px;
      }
      .hero-title em { font-style: italic; color: var(--green-light); }

      .hero-sub { font-size: 0.93rem; color: var(--muted); max-width: 420px; line-height: 1.8; margin-bottom: 40px; }

      .hero-image { position: relative; overflow: hidden; min-height: 460px; }
      .hero-image img {
        width: 100%;
        height: 110%;
        object-fit: cover;
        position: absolute;
        top: -5%;
        left: 0;
        filter: grayscale(10%) saturate(0.9);
      }
      .hero-image::before {
        content: '';
        position: absolute;
        inset: 0;
        background: linear-gradient(to right, rgba(26,58,42,0.22) 0%, transparent 60%);
        z-index: 1;
        pointer-events: none;
      }
      .hero-image::after {
        content: '';
        position: absolute;
        inset: 0;
        background: linear-gradient(180deg, transparent 50%, rgba(26,58,42,0.15) 100%);
        z-index: 1;
        pointer-events: none;
      }

      /* ── STATS BAR ── */
      .stats-bar { background: var(--green-deep); display: grid; grid-template-columns: repeat(3,1fr); width: 100%; }
      .stat-item { padding: 36px 20px; border-right: 1px solid rgba(255,255,255,0.08); text-align: center; }
      .stat-item:last-child { border-right: none; }
      .stat-number {
        font-family: 'Alphazet', serif;
        font-size: clamp(2rem, 3.5vw, 3rem);
        font-weight: 300;
        color: var(--white);
        line-height: 1;
        margin-bottom: 6px;
      }
      .stat-number span { color: var(--green-light); }
      .stat-label { font-size: 0.68rem; letter-spacing: 0.12em; text-transform: uppercase; color: rgba(255,255,255,0.5); }

      /* ══════════════════════════════════════
         SERVICIOS — #servicios
      ══════════════════════════════════════ */
      #servicios { padding: 90px var(--px); background: var(--white); width: 100%; }

      .section-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        margin-bottom: 56px;
        padding-bottom: 24px;
        border-bottom: 1px solid var(--border);
        gap: 16px;
        flex-wrap: wrap;
      }
      .section-link {
        font-size: 0.78rem;
        color: var(--muted);
        text-decoration: none;
        letter-spacing: 0.06em;
        border-bottom: 1px solid var(--border);
        padding-bottom: 3px;
        transition: color 0.2s, border-color 0.2s;
        white-space: nowrap;
        flex-shrink: 0;
      }
      .section-link:hover { color: var(--green-mid); border-color: var(--green-mid); }

      .services-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 2px; background: var(--border); width: 100%; }
      .service-card { background: var(--white); padding: 40px 28px; transition: background 0.32s; cursor: default; min-width: 0; }
      .service-card:hover { background: var(--green-deep); }
      .service-card:hover .service-number,
      .service-card:hover .service-name,
      .service-card:hover .service-desc { color: var(--white); }
      .service-card:hover .service-divider { background: rgba(255,255,255,0.18); }

      .service-number { font-family: 'DM Sans', sans-serif; font-size: 0.82rem; font-weight: 500; color: var(--green-light); margin-bottom: 20px; transition: color 0.32s; }
      .service-name { font-family: 'Alphazet', serif; font-size: 1.35rem; font-weight: 400; color: var(--green-deep); margin-bottom: 12px; transition: color 0.32s; line-height: 1.25; }
      .service-divider { width: 28px; height: 1px; background: var(--border); margin-bottom: 14px; transition: background 0.32s; }
      .service-desc { font-size: 0.84rem; color: var(--muted); line-height: 1.7; transition: color 0.32s; }

      /* ── EJES TEMÁTICOS ── */
      #ejes { padding: 72px var(--px); background: var(--green-pale); width: 100%; }
      .ejes-grid { display: grid; grid-template-columns: repeat(2,1fr); gap: 3px; background: rgba(45,106,79,0.15); margin-top: 48px; width: 100%; }
      .eje-card { background: var(--white); padding: 36px 28px; display: flex; align-items: flex-start; gap: 18px; transition: background 0.3s; min-width: 0; }
      .eje-card:hover { background: var(--green-pale); }
      .eje-icon { font-size: 1.5rem; flex-shrink: 0; margin-top: 2px; }
      .eje-content h3 { font-family: 'Alphazet', serif; font-size: 1.25rem; font-weight: 400; color: var(--green-deep); margin-bottom: 10px; }
      .eje-content p { font-size: 0.84rem; color: var(--muted); line-height: 1.7; }

      /* ══════════════════════════════════════
         NOSOTROS — #about
      ══════════════════════════════════════ */
      #about { display: grid; grid-template-columns: 1fr 1fr; width: 100%; }

      .about-image { position: relative; overflow: hidden; min-height: 400px; }
      .about-image img { width: 100%; height: 100%; object-fit: cover; object-position: center; filter: grayscale(15%) saturate(0.85); }
      .about-image::after {
        content: '';
        position: absolute;
        inset: 0;
        background: linear-gradient(to right, transparent 60%, rgba(244,248,245,0.4) 100%);
        z-index: 1;
        pointer-events: none;
      }

      .about-content { padding: 72px var(--px); display: flex; flex-direction: column; justify-content: center; background: var(--white); min-width: 0; }

      .about-quote {
        font-family: 'Alphazet', serif;
        font-size: clamp(1.1rem, 1.8vw, 1.75rem);
        font-weight: 300;
        font-style: italic;
        color: var(--green-deep);
        line-height: 1.45;
        margin-bottom: 28px;
        padding-left: 20px;
        border-left: 2px solid var(--green-light);
      }
      .about-text { font-size: 0.88rem; color: var(--muted); line-height: 1.85; margin-bottom: 32px; }

      .about-pillars { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 32px; }
      .pillar { padding: 16px 18px; border: 1px solid var(--border); border-radius: 2px; transition: border-color 0.2s, background 0.2s; min-width: 0; }
      .pillar:hover { border-color: var(--green-light); background: var(--green-pale); }
      .pillar h4 { font-size: 0.66rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--green-light); margin-bottom: 7px; font-weight: 500; }
      .pillar p { font-size: 0.81rem; color: var(--muted); line-height: 1.6; }

      .about-tags { display: flex; flex-wrap: wrap; gap: 8px; }
      .tag { padding: 6px 14px; border: 1px solid var(--border); font-size: 0.7rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--muted); border-radius: 2px; transition: all 0.2s; }
      .tag:hover { border-color: var(--green-mid); color: var(--green-mid); background: var(--green-pale); }

      /* ── EQUIPO ── */
      #equipo { padding: 90px var(--px); background: var(--bg); display: flex; flex-direction: column; align-items: center; width: 100%; }
      #equipo > .reveal { width: 100%; max-width: 560px; text-align: center; }

      .team-grid { display: flex; flex-wrap: wrap; gap: 24px; justify-content: center; align-items: stretch; width: 100%; margin-top: 52px; }
      .team-card {
        background: var(--white);
        width: clamp(200px, calc(33% - 16px), 290px);
        border: 1px solid var(--border);
        padding: 36px 24px;
        text-align: center;
        border-radius: 2px;
        transition: border-color 0.25s, box-shadow 0.25s, transform 0.25s;
        display: flex;
        flex-direction: column;
        align-items: center;
      }
      .team-card:hover { border-color: var(--green-light); box-shadow: 0 8px 32px rgba(26,58,42,0.08); transform: translateY(-4px); }

      .team-avatar {
        width: 72px;
        height: 72px;
        border-radius: 50%;
        background: var(--green-pale);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.8rem;
        margin: 0 auto 18px;
        border: 2px solid var(--green-light);
        overflow: hidden;
        flex-shrink: 0;
      }
      .team-avatar img { width: 100%; height: 100%; object-fit: cover; border-radius: 50%; }
      .team-role { font-size: 0.66rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--green-light); margin-bottom: 8px; }
      .team-name { font-family: 'Alphazet', serif; font-size: 1.05rem; font-weight: 600; color: var(--green-deep); line-height: 1.3; }

      /* ── TEAM EXPANDABLE ── */
      .team-card.expandable {
        cursor: default;
      }
      .team-toggle-btn {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: transparent;
        border: none;
        color: var(--green-mid);
        font-size: 0.8rem;
        font-weight: 500;
        letter-spacing: 0.05em;
        cursor: pointer;
        padding: 8px 0;
        margin-top: 10px;
        position: relative;
        transition: color 0.3s;
      }
      .team-toggle-btn::after {
        content: '';
        position: absolute;
        bottom: 4px;
        left: 0;
        width: 0;
        height: 1px;
        background: var(--green-light);
        transition: width 0.3s ease;
      }
      .team-toggle-btn:hover::after {
        width: 100%;
      }
      .team-toggle-btn:hover {
        color: var(--green-deep);
      }
      .team-toggle-btn .toggle-icon {
        width: 14px;
        height: 14px;
        transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1);
      }
      .team-card.expanded .team-toggle-btn .toggle-icon {
        transform: rotate(45deg);
      }
      .team-toggle-btn .toggle-text-less {
        display: none;
      }
      .team-card.expanded .team-toggle-btn .toggle-text-more {
        display: none;
      }
      .team-card.expanded .team-toggle-btn .toggle-text-less {
        display: inline;
      }
      .team-description {
        max-height: 0;
        overflow: hidden;
        transition: max-height 0.5s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.4s ease, margin 0.4s ease;
        opacity: 0;
        margin-top: 0;
      }
      .team-card.expanded .team-description {
        max-height: 400px;
        opacity: 1;
        margin-top: 16px;
      }
      .team-description p {
        font-size: 0.85rem;
        color: var(--muted);
        line-height: 1.8;
        padding-top: 16px;
        border-top: 1px solid var(--border);
      }

      /* ══════════════════════════════════════
         CONTACTO — #contacto
      ══════════════════════════════════════ */
      #contacto { padding: 90px var(--px); background: var(--white); display: grid; grid-template-columns: 1fr 1fr; gap: 64px; align-items: start; width: 100%; }
      .contact-intro { min-width: 0; }
      .contact-intro .section-title { margin-bottom: 20px; }
      .contact-intro > p { font-size: 0.88rem; color: var(--muted); line-height: 1.8; margin-bottom: 32px; }
      .contact-detail { display: flex; align-items: center; gap: 12px; margin-bottom: 14px; font-size: 0.85rem; color: var(--muted); }
      .contact-detail-icon { width: 34px; height: 34px; background: var(--green-pale); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 0.9rem; flex-shrink: 0; }
      .contact-detail strong { color: var(--green-deep); font-weight: 500; display: block; font-size: 0.7rem; letter-spacing: 0.08em; text-transform: uppercase; margin-bottom: 1px; }

      /* ══════════════════════════════════════
         RESPONSIVE — TABLET ≤1024px
      ══════════════════════════════════════ */
      @media (max-width: 1024px) {
        :root { --px: clamp(20px, 4vw, 48px); }

        #inicio { grid-template-columns: 1fr; min-height: auto; }
        .hero-text { padding: 56px var(--px); }
        .hero-image { min-height: 42vh; }
        /* En columna única la imagen no usa position:absolute */
        .hero-image img { position: relative; height: 100%; top: 0; width: 100%; object-fit: cover; }

        .services-grid { grid-template-columns: repeat(2,1fr); }

        #about { grid-template-columns: 1fr; }
        .about-image { min-height: 340px; }
        .about-content { padding: 56px var(--px); }

        #contacto { grid-template-columns: 1fr; gap: 48px; }

        .carousel-wrapper { padding: 0 70px; }
        .carousel-btn { width: 44px; height: 44px; }
      }

      /* ══════════════════════════════════════
         RESPONSIVE — MOBILE ≤768px
      ══════════════════════════════════════ */
      @media (max-width: 768px) {
        :root { --header-total: 80px; --px: 20px; }

        /* Hero */
        .hero-text { padding: 44px 20px; }
        .hero-image { min-height: 48vw; }
        .hero-sub { max-width: 100%; }
        .hero-actions { flex-direction: column; align-items: flex-start; }

        /* Stats */
        .stats-bar { grid-template-columns: 1fr; }
        .stat-item { border-right: none; border-bottom: 1px solid rgba(255,255,255,0.08); padding: 28px 20px; }
        .stat-item:last-child { border-bottom: none; }

        /* Servicios */
        .services-grid { grid-template-columns: 1fr; }
        .section-header { flex-direction: column; align-items: flex-start; gap: 14px; }
        .service-card { padding: 32px 20px; }

        /* Ejes */
        .ejes-grid { grid-template-columns: 1fr; }
        .eje-card { flex-direction: column; gap: 12px; padding: 28px 20px; }

        /* About */
        .about-content { padding: 44px 20px; }
        .about-pillars { grid-template-columns: 1fr; gap: 10px; }

        /* Equipo */
        .team-card { width: 100%; max-width: 340px; }

        /* Carousel: 1 slide */
        #galeria { padding: 52px 0 48px; }
        .galeria-header { flex-direction: column; align-items: flex-start; gap: 16px; }
        /* Contacto */
        #contacto { grid-template-columns: 1fr; gap: 40px; }

        /* Carousel mobile */
        .carousel-wrapper { padding: 0 60px; }
        .carousel-slide { padding-bottom: 66.67%; }
        #prev-btn { left: 10px; }
        #next-btn { right: 10px; }
        .carousel-btn { width: 40px; height: 40px; }
        .carousel-dots { margin-top: 20px; }
        .slide-label { padding: 40px 20px 20px; font-size: 1rem; }
      }

      /* ══════════════════════════════════════
         RESPONSIVE — SMALL MOBILE ≤480px
      ══════════════════════════════════════ */
      @media (max-width: 480px) {
        :root { --px: 16px; }
        .hero-title { font-size: clamp(2rem, 8vw, 2.6rem); }
        .stat-item { padding: 24px 16px; }
        .team-card { width: 100%; max-width: 100%; }
        .carousel-wrapper { padding: 0 50px; }
        .carousel-slide { padding-bottom: 75%; }
        #prev-btn { left: 5px; }
        #next-btn { right: 5px; }
        .carousel-btn { width: 36px; height: 36px; }
      }
    </style>
  </head>

  <body>
    <Header />

    <main>

      <!-- ══ CAROUSEL / GALERÍA ══ -->
      <section id="galeria">
        <div class="galeria-header reveal">
          <div>
            <span class="section-label">Nuestro planeta</span>
            <h2 class="section-title">Imágenes que nos<br/><em>inspiran a actuar</em></h2>
