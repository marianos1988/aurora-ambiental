    <script>
      /* ── REVEAL ON SCROLL ── */
      const revealObserver = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.add('visible');
            revealObserver.unobserve(entry.target);
          }
        });
      }, { threshold: 0.1 });
      document.querySelectorAll('.reveal').forEach(el => revealObserver.observe(el));

      /* ── PARALLAX LEVE (solo en desktop) ── */
      const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (!prefersReduced && window.innerWidth > 768) {
        const heroText = document.querySelector('.hero-text') as HTMLElement | null;
        let heroTarget = 0, heroCurrent = 0;
        function heroTick() {
          if (!heroText) return;
          heroTarget = window.scrollY * -0.05;
          heroCurrent += (heroTarget - heroCurrent) * 0.07;
          heroText.style.transform = `translateY(${heroCurrent}px)`;
          requestAnimationFrame(heroTick);
        }
        requestAnimationFrame(heroTick);
      }

      /* ══════════════════════════════════════
         CAROUSEL
      ══════════════════════════════════════ */
      (function initCarousel() {
        const galeria  = document.getElementById('galeria') as HTMLElement;
        const track    = document.getElementById('carousel-track') as HTMLElement;
        const viewport = document.getElementById('carousel-viewport') as HTMLElement;
        const dotsWrap = document.getElementById('carousel-dots') as HTMLElement;
        const prevBtn  = document.getElementById('prev-btn') as HTMLButtonElement;
        const nextBtn  = document.getElementById('next-btn') as HTMLButtonElement;

        if (!track) return;

        const slides = Array.from(track.querySelectorAll('.carousel-slide'));
        const total  = slides.length;
        let current  = 0;
        let autoTimer: ReturnType<typeof setInterval> | null = null;
        let isPaused = false;
        let isDragging = false, dragStartX = 0, dragDelta = 0;

        function cssVar(name: string) {
          return parseFloat(getComputedStyle(galeria).getPropertyValue(name)) || 0;
        }
        function visibleCount() {
          const v = cssVar('--c-visible');
          return v > 0 ? Math.round(v) : 3;
        }
        function getOffset(index: number) {
          const pad    = cssVar('--c-pad');
          const gap    = cssVar('--c-gap');
          const vis    = visibleCount();
          const slideW = (viewport.offsetWidth - pad * 2 - gap * (vis - 1)) / vis;
          return index * (slideW + gap);
        }
        function goTo(index: number, instant = false) {
          const max = Math.max(0, total - visibleCount());
          if (index < 0) current = max;
          else if (index > max) current = 0;
          else current = index;
          track.style.transition = instant ? 'none' : 'transform 0.55s cubic-bezier(0.4,0,0.2,1)';
          track.style.transform  = `translateX(-${getOffset(current)}px)`;
          updateDots();
        }
        function buildDots() {
          dotsWrap.innerHTML = '';
          const count = Math.max(1, total - visibleCount() + 1);
          for (let i = 0; i < count; i++) {
            const b = document.createElement('button');
            b.className = 'carousel-dot' + (i === 0 ? ' active' : '');
            b.addEventListener('click', () => { goTo(i); restartAuto(); });
            dotsWrap.appendChild(b);
          }
        }
        function updateDots() {
          dotsWrap.querySelectorAll('.carousel-dot')
            .forEach((d, i) => d.classList.toggle('active', i === current));
        }
        function startAuto() {
          if (autoTimer) return;
          autoTimer = setInterval(() => { if (!isPaused) goTo(current + 1); }, 4000);
        }
        function stopAuto() { if (autoTimer) { clearInterval(autoTimer); autoTimer = null; } }
        function restartAuto() { stopAuto(); startAuto(); }

        prevBtn.addEventListener('click', () => { goTo(current - 1); restartAuto(); });
        nextBtn.addEventListener('click', () => { goTo(current + 1); restartAuto(); });
        viewport.addEventListener('mouseenter', () => { isPaused = true; });
        viewport.addEventListener('mouseleave', () => { isPaused = false; });

        function onStart(x: number) { isDragging = true; isPaused = true; dragStartX = x; dragDelta = 0; track.style.transition = 'none'; }
        function onMove(x: number) {
          if (!isDragging) return;
          dragDelta = x - dragStartX;
          track.style.transform = `translateX(-${getOffset(current) - dragDelta}px)`;
        }
        function onEnd() {
          if (!isDragging) return;
          isDragging = false;
          const threshold = viewport.offsetWidth * 0.12;
          if (dragDelta < -threshold) goTo(current + 1);
          else if (dragDelta > threshold) goTo(current - 1);
          else goTo(current);
          isPaused = false;
          restartAuto();
        }

        viewport.addEventListener('mousedown',  e => onStart(e.clientX));
        viewport.addEventListener('mousemove',  e => onMove(e.clientX));
        viewport.addEventListener('mouseup',    onEnd);
        viewport.addEventListener('mouseleave', () => { if (isDragging) onEnd(); });
        viewport.addEventListener('touchstart', e => onStart(e.touches[0].clientX), { passive: true });
        viewport.addEventListener('touchmove',  e => onMove(e.touches[0].clientX),  { passive: true });
        viewport.addEventListener('touchend',   onEnd);

        buildDots();
        goTo(0, true);
        startAuto();

        let resizeTimer: ReturnType<typeof setTimeout>;
        window.addEventListener('resize', () => {
          clearTimeout(resizeTimer);
          resizeTimer = setTimeout(() => {
            buildDots();
            goTo(Math.min(current, Math.max(0, total - visibleCount())), true);
          }, 120);
        });
      })();
    </script>
  </body>
</html>