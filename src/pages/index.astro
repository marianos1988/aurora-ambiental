                <img src={Carousel7.src} alt="Parque Nacional Calilegua" loading="lazy" />
              </div>
              <div class="carousel-slide">
                <span class="slide-label">Parque Provincial Ischigualasto</span>
                <img src={Carousel8.src} alt="Parque Provincial Ischigualasto" loading="lazy" />
              </div>
              <div class="carousel-slide">
                <span class="slide-label">Parque Nacional Perito Moreno</span>
                <img src={Carousel9.src} alt="Parque Nacional Perito Moreno" loading="lazy" />
              </div>
              <div class="carousel-slide">
                <span class="slide-label">Parque Nacional Lago Epuyen</span>
                <img src={Carousel10.src} alt="Parque Nacional Lago Epuyen" loading="lazy" />
              </div>
            </div>
          </div>
          <button class="carousel-btn" id="prev-btn" aria-label="Anterior">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M15 18l-6-6 6-6"/>
