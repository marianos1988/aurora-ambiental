        <div class="carousel-dots" id="carousel-dots"></div>
      </section>

      <!-- ══ HERO ══ -->
      <section id="inicio">
        <div class="hero-text">
          <div class="hero-eyebrow reveal">
            <div class="hero-eyebrow-line"></div>
            <span>ONG · Think Tank · Buenos Aires</span>
          </div>
          <h1 class="hero-title reveal reveal-delay-1">
            Expertos en<br/><em>ambiente</em><br/>y clima
          </h1>
          <p class="hero-sub reveal reveal-delay-2">
            Somos un think tank especializado en asesoramiento, análisis y desarrollo de proyectos, regulación y políticas sostenibles basadas en evidencia científica.
          </p>
          <div class="hero-actions reveal reveal-delay-3">
            <a href="#servicios" class="btn-primary">
              Ver servicios
              <svg viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M1 7h12M7 1l6 6-6 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </a>
            <a href="#contacto" class="btn-ghost">Hablar con nosotros</a>
          </div>
        </div>
        <div class="hero-image">
          <img src="https://images.unsplash.com/photo-1441974231531-c6227db76b6e?w=1400&q=80" alt="Naturaleza y ambiente" />
        </div>
      </section>

      <!-- ══ STATS ══ -->
      <div class="stats-bar">
        <div class="stat-item reveal">
          <div class="stat-number">11<span>+</span></div>
          <div class="stat-label">Servicios especializados</div>
        </div>
        <div class="stat-item reveal reveal-delay-1">
          <div class="stat-number">4</div>
          <div class="stat-label">Disciplinas profesionales</div>
        </div>
        <div class="stat-item reveal reveal-delay-2">
          <div class="stat-number">2</div>
          <div class="stat-label">Ejes estratégicos</div>
        </div>
      </div>

